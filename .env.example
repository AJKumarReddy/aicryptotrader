# Copy to .env and fill in. .env is gitignored and must never be committed.

ENVIRONMENT=development
LOG_LEVEL=INFO
# json | text | auto (auto = json in production, text in development)
LOG_FORMAT=auto

# --- Observability ------------------------------------------------------
METRICS_ENABLED=true
# When set, /metrics requires `Authorization: Bearer <this>`. Strongly
# recommended if the service is reachable from outside your network.
METRICS_TOKEN=

# --- Identity -----------------------------------------------------------
# Clerk issuer for your instance. Find it in the Clerk dashboard under
# "API keys" -> "Show JWT public key" / Frontend API URL. Example:
#   https://sunny-mammal-12.clerk.accounts.dev
# The backend fetches ${CLERK_ISSUER}/.well-known/jwks.json to verify tokens.
CLERK_ISSUER=
# Optional hardening: comma-separated origins allowed in the token's azp claim.
CLERK_AUTHORIZED_PARTIES=http://localhost:8080

# --- Database -----------------------------------------------------------
# The anon key is safe to hold here: the user's own token is forwarded with
# every query, so row-level security decides what is readable. Do NOT put a
# service-role key in this file - the backend does not need one.
SUPABASE_URL=https://thoscfdddjqrqpwbghxk.supabase.co
SUPABASE_ANON_KEY=

# --- Browser access -----------------------------------------------------
CORS_ALLOW_ORIGINS=http://localhost:8080,http://localhost:5173

# --- Market data --------------------------------------------------------
# Free CoinGecko Demo key (~30 calls/min, 10k/month). Without it the public
# endpoint is used, which is rate limited far more aggressively.
COINGECKO_DEMO_API_KEY=

# Development only: keep holdings in memory (needed with the local dev
# issuer, whose tokens Supabase will not accept). Refused in production.
DEV_LOCAL_PORTFOLIO=false
